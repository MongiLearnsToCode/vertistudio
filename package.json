{
  "name": "verti-studio",
  "productName": "Verti Studio",
  "version": "0.1.2",
  "description": "Local video cutting and vertical export studio",
  "main": "out/main/index.js",
  "author": "Verti Studio",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "icons": "node scripts/generate-placeholder-icon.js",
    "setup": "node scripts/setup.js",
    "rebrand": "node scripts/rebrand.js",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:feature": "plop feature",
    "new:ipc": "plop ipc",
    "start": "node scripts/start.js",
    "package:local": "npm run build && node scripts/package-local.js",
    "release:tools": "node scripts/prepare-release-tools.js",
    "release:publish": "node scripts/publish-release.mjs",
    "build:deb": "electron-vite build && electron-builder --linux deb --publish never"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.5.0",
    "jsdom": "29.1.0",
    "plop": "4.0.5",
    "prettier": "3.8.3",
    "rollup": "4.59.0",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-table": "8.21.3",
    "electron-log": "5.4.3",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3",
    "lucide-react": "1.14.0",
    "motion": "^14.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.59.0"
  },
  "overrides": {
    "fast-uri": "^3.1.2"
  },
  "homepage": "https://verti-studio.oligasibanda.workers.dev"
}
